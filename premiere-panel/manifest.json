{
  "manifestVersion": 5,
  "id": "com.strike2911.xomacito.link",
  "name": "Xomacito Link",
  "version": "1.6.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "xomacitoLinkPanel",
      "label": { "default": "Xomacito Link" },
      "minimumSize": { "width": 280, "height": 330 },
      "preferredDockedSize": { "width": 340, "height": 400 },
      "preferredFloatingSize": { "width": 420, "height": 720 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}
